# Personal/site-specific config - copy satellites.example.yaml to
# satellites.yaml and fill in your own ground station details instead.
satellites.yaml

# Generated by plan_passes.py - your personal approved-pass list
schedule.yaml

# Fetched TLE data - refresh it yourself, don't commit stale orbital elements
tle/*.txt
!tle/.gitkeep

# Compiled from .grc by grcc/GNU Radio Companion - regenerate locally,
# these can embed your local decoder file paths and are host-specific
flowgraphs/*.py

# grcc also drops companion files for embedded/epy_block helpers at the
# repo root regardless of -o - same reasoning as flowgraphs/*.py above
*_rig_freq_poller_*.py

# Runtime lock for run_passes.py - only exists while it's actually running
# (or after a crash that didn't clean up); never something to commit
run_passes.lock

# Captured IQ recordings and decoded KISS frames - large, personal, and
# not something you want in git history
*.kss
*.iq
*.cfile

# Runtime logs
*.log

# Python
__pycache__/
*.pyc

# Editor/OS cruft
.DS_Store
*.swp
run_passes.out

# kiss_encode_pdu.py is hand-written reference code, not a compiled
# flowgraph output - keep it tracked despite the flowgraphs/*.py ignore
!flowgraphs/kiss_encode_pdu.py
