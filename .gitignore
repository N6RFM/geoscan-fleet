# Personal/site-specific config - copy satellites.example.yaml to
# satellites.yaml and fill in your own ground station details instead.
satellites.yaml

# Generated by plan_passes.py - your personal approved-pass list
schedule.yaml

# Fetched TLE data - refresh it yourself, don't commit stale orbital elements
tle/*.txt
!tle/.gitkeep

# Compiled from .grc by grcc/GNU Radio Companion - regenerate locally,
# these can embed your local decoder file paths and are host-specific
flowgraphs/*.py

# Captured IQ recordings and decoded KISS frames - large, personal, and
# not something you want in git history
*.kss
*.iq
*.cfile

# Runtime logs
*.log

# Python
__pycache__/
*.pyc

# Editor/OS cruft
.DS_Store
*.swp
